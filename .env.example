# ═══════════════════════════════════════
# TruckRental — Environment Variables Template
# ═══════════════════════════════════════
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ── Database ──
DB_HOST=your_db_host_ip_or_hostname
DB_PORT=5432
DB_NAME=your_db_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ── JWT ──
JWT_SECRET=your-jwt-secret-minimum-256-bits-long

# ── App ──
# Must match the deployed server's public URL (e.g., https://truckrent.g-axis.in)
APP_BASE_URL=https://your-deployed-url.com
# ── File Storage ──
 # Uncomment the line that matches your environment. Comment out the other.
 #
 # Local development (Windows):
 # FILE_UPLOAD_DIR=D:\proj1\TruckRental\vibe_coding_backend_java\uploads
 #
 # Deployment (Docker / Linux VM):
 # FILE_UPLOAD_DIR=/app/uploads

# CORS origins allowed to call the API (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Profile Control ──
# local = Docker PostgreSQL (safe for dev/testing — DEFAULT for local machine)
# dev   = Company DB (use only when intentionally syncing with company DB)

SPRING_PROFILES_ACTIVE=dev

# ── Database (for dev/prod profiles — uses DB_HOST/PORT/NAME) ──
# For prod profile, set DATABASE_URL instead (full JDBC URL)
# DATABASE_URL=jdbc:postgresql://35.225.235.66:5432/db_truck_rental

# ── Email (SMTP credentials — required in all profiles) ──
# SMTP host (smtp.gmail.com) and port (587) are hardcoded in application.yml — no vars needed.
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Payment Gateways (Phase 6) ──
# Active gateway and currency are stored in DB (platform_settings table), not here.
# These are API credentials only.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_ACCOUNT_NUMBER=   # Razorpay X virtual account number (required for owner payouts)

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
